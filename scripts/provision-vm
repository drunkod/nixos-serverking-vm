#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  provision-vm <name> [instance-type] [disk-size] [base-disk]

Environment:
  SERVERKING_NAMESPACE       default: tenant-u665
  SERVERKING_STORAGE_CLASS   default: replicated2
  SSH_PUBLIC_KEY             public key to inject
  SSH_PUBLIC_KEY_FILE        fallback public-key file
  EXTERNAL_PORTS             comma-separated, default: 22
  WAIT_TIMEOUT               kubectl wait timeout, default: 10m
EOF
  exit 2
}

[[ $# -ge 1 && $# -le 4 ]] || usage

VM_NAME="$1"
INSTANCE_TYPE="${2:-u1.small}"
DISK_SIZE="${3:-20Gi}"
BASE_DISK="${4:-nixos-26-05-v1}"
ROOT_DISK="${VM_NAME}-root"

NAMESPACE="${SERVERKING_NAMESPACE:-tenant-u665}"
STORAGE_CLASS="${SERVERKING_STORAGE_CLASS:-replicated2}"
EXTERNAL_PORTS="${EXTERNAL_PORTS:-22}"
WAIT_TIMEOUT="${WAIT_TIMEOUT:-10m}"
SSH_PUBLIC_KEY_FILE="${SSH_PUBLIC_KEY_FILE:-nixos-minimal.pub}"

[[ "$VM_NAME" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || {
  echo "Invalid VM name: $VM_NAME" >&2
  exit 2
}

if [[ -z "${SSH_PUBLIC_KEY:-}" ]]; then
  [[ -f "$SSH_PUBLIC_KEY_FILE" ]] || {
    echo "Set SSH_PUBLIC_KEY or provide $SSH_PUBLIC_KEY_FILE" >&2
    exit 2
  }
  SSH_PUBLIC_KEY="$(tr -d '\r\n' < "$SSH_PUBLIC_KEY_FILE")"
fi

kubectl get "vmdisk.apps.cozystack.io/$BASE_DISK" -n "$NAMESPACE" >/dev/null

if kubectl get "vmdisk.apps.cozystack.io/$ROOT_DISK" -n "$NAMESPACE" >/dev/null 2>&1; then
  source_name="$(kubectl get "vmdisk.apps.cozystack.io/$ROOT_DISK" -n "$NAMESPACE" -o jsonpath='{.spec.source.disk.name}')"
  existing_size="$(kubectl get "vmdisk.apps.cozystack.io/$ROOT_DISK" -n "$NAMESPACE" -o jsonpath='{.spec.storage}')"
  existing_class="$(kubectl get "vmdisk.apps.cozystack.io/$ROOT_DISK" -n "$NAMESPACE" -o jsonpath='{.spec.storageClass}')"

  if [[ "$source_name" != "$BASE_DISK" || "$existing_size" != "$DISK_SIZE" || "$existing_class" != "$STORAGE_CLASS" ]]; then
    echo "VMDisk $ROOT_DISK already exists with a different specification." >&2
    exit 1
  fi

  echo "Root disk $ROOT_DISK already exists."
else
  export ROOT_DISK BASE_DISK DISK_SIZE STORAGE_CLASS NAMESPACE
  python3 - <<'PY' | kubectl create -f -
import json
import os
import sys

json.dump(
    {
        "apiVersion": "apps.cozystack.io/v1alpha1",
        "kind": "VMDisk",
        "metadata": {
            "name": os.environ["ROOT_DISK"],
            "namespace": os.environ["NAMESPACE"],
        },
        "spec": {
            "optical": False,
            "source": {"disk": {"name": os.environ["BASE_DISK"]}},
            "storage": os.environ["DISK_SIZE"],
            "storageClass": os.environ["STORAGE_CLASS"],
        },
    },
    sys.stdout,
)
PY
fi

echo "Waiting for root disk..."
kubectl wait --for=condition=Ready   "vmdisk.apps.cozystack.io/$ROOT_DISK"   -n "$NAMESPACE"   --timeout="$WAIT_TIMEOUT"

if kubectl get "vminstance.apps.cozystack.io/$VM_NAME" -n "$NAMESPACE" >/dev/null 2>&1; then
  attached="$(kubectl get "vminstance.apps.cozystack.io/$VM_NAME" -n "$NAMESPACE" -o jsonpath='{.spec.disks[0].name}')"
  if [[ "$attached" != "$ROOT_DISK" ]]; then
    echo "VMInstance $VM_NAME already exists with a different root disk." >&2
    exit 1
  fi

  echo "VMInstance $VM_NAME already exists."
else
  export VM_NAME ROOT_DISK INSTANCE_TYPE NAMESPACE SSH_PUBLIC_KEY EXTERNAL_PORTS
  python3 - <<'PY' | kubectl create -f -
import json
import os
import sys
import time

ports = []
for value in os.environ["EXTERNAL_PORTS"].split(","):
    value = value.strip()
    if not value:
        continue
    port = int(value)
    if not 1 <= port <= 65535:
        raise SystemExit(f"Invalid TCP port: {port}")
    ports.append(port)

name = os.environ["VM_NAME"]
json.dump(
    {
        "apiVersion": "apps.cozystack.io/v1alpha1",
        "kind": "VMInstance",
        "metadata": {
            "name": name,
            "namespace": os.environ["NAMESPACE"],
        },
        "spec": {
            "instanceProfile": "linux.efi",
            "instanceType": os.environ["INSTANCE_TYPE"],
            "disks": [{"name": os.environ["ROOT_DISK"]}],
            "runStrategy": "Always",
            "external": True,
            "externalMethod": "PortList",
            "externalPorts": sorted(set(ports)),
            "externalAllowICMP": True,
            "sshKeys": [os.environ["SSH_PUBLIC_KEY"]],
            "cloudInit": f"#cloud-config\nhostname: {name}\nmanage_etc_hosts: true\n",
            "cloudInitSeed": f"{name}-{int(time.time())}",
            "networks": [],
            "subnets": [],
            "gpus": [],
            "resources": {},
            "cpuModel": "",
        },
    },
    sys.stdout,
)
PY
fi

echo "Waiting for VMInstance..."
kubectl wait --for=condition=Ready   "vminstance.apps.cozystack.io/$VM_NAME"   -n "$NAMESPACE"   --timeout="$WAIT_TIMEOUT"

echo
echo "Provisioning result:"
kubectl get "vminstance.apps.cozystack.io/$VM_NAME"   -n "$NAMESPACE"   -o custom-columns='NAME:.metadata.name,TYPE:.spec.instanceType,PROFILE:.spec.instanceProfile,READY:.status.conditions[?(@.type=="Ready")].status'

echo
echo "Network services:"
kubectl get services -n "$NAMESPACE" -o json |
  VM_NAME="$VM_NAME" python3 -c '
import json
import os
import sys

data = json.load(sys.stdin)
name = os.environ["VM_NAME"]
items = [
    item
    for item in data.get("items", [])
    if item.get("metadata", {}).get("name") == "vm-instance-" + name
    or name in item.get("metadata", {}).get("name", "")
]

if not items:
    print("No matching Service found yet.")
    raise SystemExit(0)

for service in items:
    metadata = service.get("metadata", {})
    spec = service.get("spec", {})
    status = service.get("status", {})
    ingress = status.get("loadBalancer", {}).get("ingress", [])
    addresses = [
        entry.get("ip") or entry.get("hostname")
        for entry in ingress
        if entry.get("ip") or entry.get("hostname")
    ]
    addresses += spec.get("externalIPs", [])
    ports = [str(entry.get("port")) for entry in spec.get("ports", [])]
    service_name = metadata.get("name")
    address_text = ",".join(addresses) or "pending"
    ports_text = ",".join(ports) or "-"
    print(f"{service_name}: address={address_text} ports={ports_text}")
'
