#!/usr/bin/env bash
set -euo pipefail

: "${SERVERKING_TOKEN:?SERVERKING_TOKEN is required}"
: "${SERVERKING_CA_B64:?SERVERKING_CA_B64 is required}"

OUT="${1:-${RUNNER_TEMP:-/tmp}/serverking-kubeconfig}"
NAMESPACE="${SERVERKING_NAMESPACE:-tenant-u665}"
SERVER="${SERVERKING_API_SERVER:-https://177.29.240.30:6443}"

umask 077
cat > "$OUT" <<EOF
apiVersion: v1
kind: Config
clusters:
- name: serverking
  cluster:
    server: $SERVER
    certificate-authority-data: $SERVERKING_CA_B64
contexts:
- name: serverking
  context:
    cluster: serverking
    namespace: $NAMESPACE
    user: serverking-ci
current-context: serverking
users:
- name: serverking-ci
  user:
    token: $SERVERKING_TOKEN
EOF

chmod 600 "$OUT"
printf '%s\n' "$OUT"
