#!/usr/bin/env bash
set -euo pipefail

NAMESPACE="${SERVERKING_NAMESPACE:-tenant-u665}"

if [[ -z "${KUBECONFIG:-}" ]]; then
  echo "KUBECONFIG is not set" >&2
  exit 2
fi

command -v kubectl >/dev/null || {
  echo "kubectl is required" >&2
  exit 2
}

echo "Checking tenant-scoped Kubernetes API access..."
# Do not use kubectl cluster-info here: it reads Services in kube-system,
# which a correctly scoped ServerKing tenant service account cannot access.
kubectl get vmdisks.apps.cozystack.io -n "$NAMESPACE" --request-timeout=10s >/dev/null

checks=(
  "get vmdisks.apps.cozystack.io"
  "list vmdisks.apps.cozystack.io"
  "create vmdisks.apps.cozystack.io"
  "get vminstances.apps.cozystack.io"
  "list vminstances.apps.cozystack.io"
  "create vminstances.apps.cozystack.io"
  "get services"
  "list services"
  "get ingresses.networking.k8s.io"
  "list ingresses.networking.k8s.io"
  "get httpcaches.apps.cozystack.io"
  "list httpcaches.apps.cozystack.io"
  "create httpcaches.apps.cozystack.io"
)

failed=0
for check in "${checks[@]}"; do
  verb="${check%% *}"
  resource="${check#* }"
  if kubectl auth can-i "$verb" "$resource" -n "$NAMESPACE" | grep -qx yes; then
    printf '  yes  %-6s %s\n' "$verb" "$resource"
  else
    printf '  NO   %-6s %s\n' "$verb" "$resource" >&2
    failed=1
  fi
done

echo
echo "Gateway API diagnostics..."
for resource in gateways.gateway.networking.k8s.io httproutes.gateway.networking.k8s.io; do
  if kubectl api-resources --api-group=gateway.networking.k8s.io -o name | grep -qx "$resource"; then
    echo "  API  present  $resource"
  else
    echo "  API  missing  $resource"
  fi
  for verb in get list create; do
    if kubectl auth can-i "$verb" "$resource" -n "$NAMESPACE" | grep -qx yes; then
      printf '  yes  %-6s %s\\n' "$verb" "$resource"
    else
      printf '  NO   %-6s %s\\n' "$verb" "$resource"
    fi
  done
done

if kubectl auth can-i get namespaces | grep -qx yes; then
  gateway_annotation="$(kubectl get namespace "$NAMESPACE" -o jsonpath='{.metadata.annotations.namespace\\.cozystack\\.io/gateway}' 2>/dev/null || true)"
  echo "  namespace gateway annotation: ${gateway_annotation:-<empty>}"
else
  echo "  namespace gateway annotation: <cannot read namespaces>"
fi

echo "  Gateways visible in $NAMESPACE:"
kubectl get gateways.gateway.networking.k8s.io -n "$NAMESPACE" -o wide 2>&1 | sed 's/^/    /' || true
echo "  HTTPRoutes visible in $NAMESPACE:"
kubectl get httproutes.gateway.networking.k8s.io -n "$NAMESPACE" -o wide 2>&1 | sed 's/^/    /' || true

if (( failed )); then
  echo "Required ServerKing/Cozystack RBAC permissions are missing." >&2
  exit 1
fi

echo "ServerKing API access is ready for namespace: $NAMESPACE"
